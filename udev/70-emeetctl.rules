# emeetctl: acesso do usuário logado ao canal HID da EMEET SmartCam S600L (controle da luz).
# O vídeo (/dev/videoN) já é acessível pelo grupo video / uaccess.
KERNEL=="hidraw*", ATTRS{idVendor}=="328f", ATTRS{idProduct}=="00ef", MODE="0660", TAG+="uaccess"
# Câmera virtual: o usuário logado pode criar o dispositivo "emeetctl Camera" no v4l2loopback.
KERNEL=="v4l2loopback", MODE="0660", TAG+="uaccess"
